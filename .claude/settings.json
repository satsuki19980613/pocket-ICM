{
  "$comment": "env ファイル（実値を含む .env / .env.local / .env.*.local）は Claude Code から読み書き禁止。値は端末内に留める（.env.example は雛形なので対象外）。",
  "permissions": {
    "deny": [
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.*.local)",
      "Edit(./**/.env)",
      "Edit(./**/.env.local)",
      "Edit(./**/.env.*.local)",
      "Write(./**/.env)",
      "Write(./**/.env.local)",
      "Write(./**/.env.*.local)"
    ]
  }
}
