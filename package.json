{
  "name": "oshihiki-note",
  "version": "0.1.0",
  "private": true,
  "description": "Black Ops ICM — ポーカーチェイス クラブマッチ push/fold ICM 復習ツール",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty && tsc -p packages/solver/tsconfig.scripts.json && npm run typecheck:app && npm run typecheck:worker",
    "typecheck:app": "tsc --noEmit -p packages/app",
    "typecheck:worker": "tsc -p worker --noEmit",
    "gen:hu-equity": "tsx packages/solver/scripts/genHuEquityTable.ts",
    "gen:hu-wintie": "tsx packages/solver/scripts/genHuWinTieTable.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260915.1",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "wrangler": "^4.131.2"
  },
  "dependencies": {
    "zod": "^3.24.1"
  },
  "engines": {
    "node": ">=20"
  }
}
